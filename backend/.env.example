APP_ENV=development
APP_DEBUG=true
# Docker PostgreSQL is exposed to locally-run FastAPI/Alembic on port 5434.
DATABASE_URL=postgresql+psycopg://pulseforge:change-me-local-only@127.0.0.1:5434/pulseforge
CORS_ORIGINS=http://localhost:3000

# Generate a long random value for any non-development environment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
REFRESH_COOKIE_NAME=pulseforge_refresh
API_KEY_PEPPER=replace-with-an-independent-long-random-secret
